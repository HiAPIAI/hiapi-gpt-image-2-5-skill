  "gpt-image-2.5-flare@pro": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "aspect_ratio": {
        "default": "1:1",
        "description": "选择输出画幅或像素尺寸；auto 由模型根据请求决定。",
        "enum": [
          "1:1",
          "3:2",
          "2:3",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "auto",
          "1024x1024",
          "1536x1024",
          "1024x1536",
          "1536x1152",
          "1152x1536",
          "2048x2048",
          "2048x1152",
          "1152x2048",
          "3840x2160",
          "2160x3840"
        ],
        "title": "图片尺寸",
        "type": "string"
      },
      "background": {
        "default": "auto",
        "description": "选择自动、透明或不透明背景。",
        "enum": [
          "auto",
          "transparent",
          "opaque"
        ],
        "title": "背景",
        "type": "string"
      },
      "image_urls": {
        "description": "可选的参考图片；传入后用于编辑、合成或保持主体与风格。",
        "items": {
          "format": "uri",
          "pattern": "^[hH][tT][tT][pP][sS]?://[^\\s/?#]+(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$",
          "type": "string"
        },
        "maxItems": 16,
        "minItems": 1,
        "title": "参考图片",
        "type": "array"
      },
      "model": {
        "default": "gpt-image-2.5-flare@pro",
        "description": "Model name",
        "enum": [
          "gpt-image-2.5-flare@pro"
        ],
        "type": "string"
      },
      "output_format": {
        "default": "webp",
        "description": "选择输出图片格式。",
        "enum": [
          "png",
          "jpeg",
          "webp"
        ],
        "title": "输出格式",
        "type": "string"
      },
      "prompt": {
        "description": "描述要生成的画面，或说明需要对参考图片执行的修改。 Max 8000 characters.",
        "maxLength": 8000,
        "minLength": 1,
        "title": "提示词",
        "type": "string"
      },
      "quality": {
        "default": "medium",
        "description": "选择输出细节、生成速度和价格档位。",
        "enum": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "auto"
        ],
        "title": "画质",
        "type": "string"
      }
    },
    "required": [
      "prompt",
      "model"
    ],
    "type": "object"
  },
