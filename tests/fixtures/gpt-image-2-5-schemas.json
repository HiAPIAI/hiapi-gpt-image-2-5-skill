{
  "gpt-image-2.5-flare/text-to-image": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "background": {
              "enum": [
                "auto",
                "opaque",
                "transparent"
              ]
            }
          },
          "required": [
            "background"
          ]
        },
        "then": {
          "properties": {
            "resolution": {
              "enum": [
                "1K"
              ]
            }
          }
        }
      }
    ],
    "properties": {
      "aspect_ratio": {
        "default": "auto",
        "description": "Output aspect ratio. Defaults to auto if omitted.",
        "enum": [
          "auto",
          "1:1",
          "3:2",
          "2:3",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "21:9",
          "27:16",
          "16:27",
          "9:8",
          "8:9"
        ],
        "title": "Aspect Ratio",
        "type": "string"
      },
      "background": {
        "description": "Background mode. Supported only at 1K resolution; omit for 2K/4K.",
        "enum": [
          "transparent",
          "opaque",
          "auto"
        ],
        "type": "string"
      },
      "model": {
        "default": "gpt-image-2.5-flare/text-to-image",
        "description": "Model name",
        "enum": [
          "gpt-image-2.5-flare/text-to-image"
        ],
        "type": "string"
      },
      "prompt": {
        "description": "Describe the image to generate. Max 8000 characters.",
        "maxLength": 8000,
        "minLength": 1,
        "title": "Prompt",
        "type": "string"
      },
      "resolution": {
        "default": "1K",
        "description": "Output resolution tier.",
        "enum": [
          "1K",
          "2K",
          "4K"
        ],
        "title": "Resolution",
        "type": "string"
      }
    },
    "required": [
      "prompt",
      "model"
    ],
    "type": "object"
  },
